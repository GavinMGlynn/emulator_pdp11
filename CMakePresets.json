{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_COMPILER": "clang"
      }
    },
    {
      "name": "debug-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PDP11_WERROR": "ON"
      }
    },
    {
      "name": "release-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },

    { "name": "linux-debug",   "inherits": "debug-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" } },
    { "name": "linux-ci",      "inherits": "debug-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" } },
    { "name": "linux-release", "inherits": "release-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON" } },

    { "name": "macos-debug",   "inherits": "debug-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" } },
    { "name": "macos-ci",      "inherits": "debug-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" } },
    { "name": "macos-release", "inherits": "release-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": { "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON" } },

    { "name": "windows-debug",   "inherits": "debug-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "CMAKE_C_FLAGS": "-D_CRT_SECURE_NO_WARNINGS" } },
    { "name": "windows-ci",      "inherits": "debug-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "CMAKE_C_FLAGS": "-D_CRT_SECURE_NO_WARNINGS" } },
    { "name": "windows-release", "inherits": "release-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "CMAKE_C_FLAGS": "-D_CRT_SECURE_NO_WARNINGS" } }
  ],
  "buildPresets": [
    { "name": "linux-debug",   "configurePreset": "linux-debug" },
    { "name": "linux-ci",      "configurePreset": "linux-ci" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "macos-debug",   "configurePreset": "macos-debug" },
    { "name": "macos-ci",      "configurePreset": "macos-ci" },
    { "name": "macos-release", "configurePreset": "macos-release" },
    { "name": "windows-debug",   "configurePreset": "windows-debug" },
    { "name": "windows-ci",      "configurePreset": "windows-ci" },
    { "name": "windows-release", "configurePreset": "windows-release" }
  ],
  "testPresets": [
    { "name": "linux-debug",   "configurePreset": "linux-debug",   "output": { "outputOnFailure": true } },
    { "name": "linux-ci",      "configurePreset": "linux-ci",      "output": { "outputOnFailure": true } },
    { "name": "linux-release", "configurePreset": "linux-release", "output": { "outputOnFailure": true } },
    { "name": "macos-ci",      "configurePreset": "macos-ci",      "output": { "outputOnFailure": true } },
    { "name": "windows-ci",    "configurePreset": "windows-ci",    "output": { "outputOnFailure": true } }
  ]
}
